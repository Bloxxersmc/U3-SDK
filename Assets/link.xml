<!--
  IL2CPP (used by WebGL/WebGPU builds) strips code it can't see being used. Unturned creates asset
  types, UI and network handlers by name through reflection, so keep the game's assemblies whole.
-->
<linker>
  <assembly fullname="Assembly-CSharp" preserve="all" />
  <assembly fullname="UnityEx" preserve="all" />
  <assembly fullname="SystemEx" preserve="all" />
  <assembly fullname="UnturnedDat" preserve="all" />
  <assembly fullname="SDG.NetPak.Runtime" preserve="all" />
  <assembly fullname="SDG.NetTransport" preserve="all" />
  <assembly fullname="SDG.Glazier.Runtime" preserve="all" />
  <assembly fullname="SDG.HostBans.Runtime" preserve="all" />
  <assembly fullname="Unturned.LiveConfig.Runtime" preserve="all" />
  <assembly fullname="com.rlabrecque.steamworks.net" preserve="all" />
  <assembly fullname="Newtonsoft.Json" preserve="all" />
  <assembly fullname="Unity.Postprocessing.Runtime" preserve="all" />
  <assembly fullname="Unity.TextMeshPro" preserve="all" />
  <assembly fullname="UnityEngine.UI" preserve="all" />
</linker>
